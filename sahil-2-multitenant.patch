@@ -0,0 +1,42 @@
+# HR Portal (multi-tenant)
+
+Companies sign themselves up, wait for approval, then onboard their own employees, departments and
+custom roles. Built on Vite + React, Express / Vercel functions, Firestore and Firebase Authentication.
+
+## How it works
+
+- **Sign-up**: a company registers with email + password. It is `PENDING` and can see nothing until a
+  platform admin approves it (then it is `ACTIVE` with the modules you enable).
+- **Login**: email + password only. The server looks up which company the account belongs to.
+- **Roles**: each company gets default roles (Company Admin, Head HR, HR, Approver/Founder, Department
+  Head, Employee) and can create its own from a permission checklist. Nobody can grant a permission they
+  do not hold themselves.
+- **Security**: the server (Firebase Admin "master key") creates logins and writes `cid / cs / perms / adm`
+  claims onto the user's ID token. `firestore.rules` and every API route trust only those claims, so one
+  company can never read another's data.
+
+## Setup
+
+1. Create a Firebase project with **Authentication (Email/Password)** and **Firestore**; put the web config
+   in `firebase-applet-config.json`.
+2. Create a service account key (Project settings > Service accounts) and set
+   `FIREBASE_SERVICE_ACCOUNT_JSON` (see `.env.example`).
+3. Deploy the rules: `firebase deploy --only firestore:rules`.
+4. Make yourself platform admin (can approve companies):
+   `npx tsx scripts/make-platform-admin.ts you@example.com --create 'a-strong-password'`
+5. `npm install && npm run dev` (or deploy to Vercel with the same env vars).
+
+### Migrating the existing single company
+
+`npx tsx scripts/migrate-to-multitenant.ts --company "Amaavigo Group" --admin admin@yourco.com`
+(add `--dry-run` first). It prints the company id: set it as `HOME_COMPANY_ID`.
+
+## Known limits
+
+- Google Sheet, careers API, onboarding and AI candidate evaluation use one global configuration, so they
+  are limited to the `HOME_COMPANY_ID` company.
+- Email is sent from one shared SMTP account for all companies.
+- Some screens and document stamps still say "Amaavigo".
+- Old uploaded-file links have no signature; set `LEGACY_OPEN_STORAGE=true` while migrating, then off.
+- Requisition step-by-step workflow rules are enforced in the app; the Firestore rules enforce tenant and
+  permission checks only.
diff --git a/api/_lib/authContext.ts b/api/_lib/authContext.ts
new file mode 100644
index 0000000..903f974
--- /dev/null
+++ b/api/_lib/authContext.ts
@@ -0,0 +1,102 @@
+/**
+ * Verified request identity. Replaces the old spoofable `x-user-role` header.
+ * The browser sends `Authorization: Bearer <Firebase ID token>`; we verify the signature with the
+ * Admin SDK and read the company / permission claims that only the server can write.
+ */
+import { adminAuth } from './firebaseAdmin.js';
+import { hasPerm, type TenantClaims } from '../../shared/permissions.js';
+
+export interface AuthContext {
+  uid: string;
+  email: string;
+  companyId: string | null;
+  companyStatus: 'PENDING' | 'ACTIVE' | 'SUSPENDED' | null;
+  perms: string[];
+  isCompanyAdmin: boolean;
+  isPlatformAdmin: boolean;
+}
+
+export class AuthError extends Error {
+  constructor(public status: number, message: string) {
+    super(message);
+  }
+}
+
+function header(headers: Record<string, any> | undefined, name: string): string {
+  if (!headers) return '';
+  const v = headers[name] ?? headers[name.toLowerCase()];
+  return Array.isArray(v) ? String(v[0] || '') : String(v || '');
+}
+
+export async function authenticate(headers: Record<string, any> | undefined): Promise<AuthContext> {
+  const raw = header(headers, 'authorization');
+  const token = raw.replace(/^Bearer\s+/i, '').trim();
+  if (!token) throw new AuthError(401, 'Sign in required.');
+
+  let decoded: any;
+  try {
+    decoded = await adminAuth().verifyIdToken(token);
+  } catch {
+    throw new AuthError(401, 'Your session has expired. Please sign in again.');
+  }
+
+  const claims = decoded as TenantClaims & Record<string, any>;
+  return {
+    uid: decoded.uid,
+    email: String(decoded.email || '').toLowerCase(),
+    companyId: claims.cid ? String(claims.cid) : null,
+    companyStatus: (claims.cs as AuthContext['companyStatus']) || null,
+    perms: Array.isArray(claims.perms) ? claims.perms.map(String) : [],
+    isCompanyAdmin: claims.adm === true,
+    isPlatformAdmin: claims.pa === true,
+  };
+}
+
+/** Requires a signed-in user whose company is approved and active. Platform admins pass without a company. */
+export async function requireActiveTenant(headers: Record<string, any> | undefined): Promise<AuthContext> {
+  const ctx = await authenticate(headers);
+  if (ctx.isPlatformAdmin) return ctx;
+  if (!ctx.companyId) throw new AuthError(403, 'Your account is not linked to a company.');
+  if (ctx.companyStatus === 'PENDING') throw new AuthError(403, 'Your company is awaiting approval.');
+  if (ctx.companyStatus !== 'ACTIVE') throw new AuthError(403, 'Your company account is not active.');
+  return ctx;
+}
+
+export async function requirePermission(headers: Record<string, any> | undefined, ...anyOf: string[]): Promise<AuthContext> {
+  const ctx = await requireActiveTenant(headers);
+  if (ctx.isCompanyAdmin) return ctx;
+  if (!anyOf.some((p) => hasPerm(ctx.perms, p))) {
+    throw new AuthError(403, 'You do not have permission to do this.');
+  }
+  return ctx;
+}
+
+export async function requirePlatformAdmin(headers: Record<string, any> | undefined): Promise<AuthContext> {
+  const ctx = await authenticate(headers);
+  if (!ctx.isPlatformAdmin) throw new AuthError(403, 'Platform administrators only.');
+  return ctx;
+}
+
+export function authErrorResponse(err: unknown): { status: number; json: { success: false; error: string } } | null {
+  if (err instanceof AuthError) return { status: err.status, json: { success: false, error: err.message } };
+  return null;
+}
+
+/**
+ * Features backed by ONE global configuration (the Google Sheet, the amaavigo.com careers API,
+ * the candidate onboarding collections) are only available to the "home" company until those
+ * settings become per-company. Set HOME_COMPANY_ID to the company id that owns them.
+ */
+export function assertHomeTenant(ctx: AuthContext): void {
+  if (ctx.isPlatformAdmin) return;
+  const home = (process.env.HOME_COMPANY_ID || '').trim();
+  if (!home || ctx.companyId !== home) {
+    throw new AuthError(403, 'This feature is not enabled for your company yet.');
+  }
+}
+
+export async function requireHomeTenantPermission(headers: Record<string, any> | undefined, ...anyOf: string[]): Promise<AuthContext> {
+  const ctx = await requirePermission(headers, ...anyOf);
+  assertHomeTenant(ctx);
+  return ctx;
+}
diff --git a/api/_lib/firebaseAdmin.ts b/api/_lib/firebaseAdmin.ts
new file mode 100644
index 0000000..04899ff
--- /dev/null
+++ b/api/_lib/firebaseAdmin.ts
@@ -0,0 +1,75 @@
+/**
+ * Firebase Admin SDK (service account). This is the "master key": it is the only thing that can
+ * create login accounts and stamp the company / permission claims onto a user's ID token.
+ * It must only ever run on the server (Vercel env vars / local .env) - never in the browser.
+ *
+ * FIREBASE_SERVICE_ACCOUNT_JSON accepts either the raw JSON or the same JSON base64-encoded
+ * (base64 is easier to paste into hosting dashboards).
+ */
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { applicationDefault, cert, getApp, getApps, initializeApp, type App } from 'firebase-admin/app';
+import { getAuth, type Auth } from 'firebase-admin/auth';
+import { getFirestore, type Firestore } from 'firebase-admin/firestore';
+
+const fileConfig: Record<string, any> = (() => {
+  try {
+    return JSON.parse(readFileSync(join(process.cwd(), 'firebase-applet-config.json'), 'utf8'));
+  } catch {
+    return {};
+  }
+})();
+
+function readServiceAccount(): Record<string, any> | null {
+  const raw = (process.env.FIREBASE_SERVICE_ACCOUNT_JSON || '').trim();
+  if (!raw) return null;
+  const text = raw.startsWith('{') ? raw : Buffer.from(raw, 'base64').toString('utf8');
+  try {
+    const parsed = JSON.parse(text);
+    if (typeof parsed.private_key === 'string') parsed.private_key = parsed.private_key.replace(/\\n/g, '\n');
+    return parsed;
+  } catch {
+    throw new Error('FIREBASE_SERVICE_ACCOUNT_JSON is set but is not valid JSON (or base64 JSON).');
+  }
+}
+
+export function isAdminConfigured(): boolean {
+  return !!(process.env.FIREBASE_SERVICE_ACCOUNT_JSON || '').trim();
+}
+
+let appInstance: App | null = null;
+
+export function adminApp(): App {
+  if (appInstance) return appInstance;
+  const existing = getApps().find((a) => a.name === 'tenant-admin');
+  if (existing) {
+    appInstance = getApp('tenant-admin');
+    return appInstance;
+  }
+  const sa = readServiceAccount();
+  if (!sa) {
+    throw new Error(
+      'FIREBASE_SERVICE_ACCOUNT_JSON is not configured. Create a service account key in the Firebase console ' +
+        '(Project settings > Service accounts) and set it as an environment variable.'
+    );
+  }
+  appInstance = initializeApp(
+    {
+      credential: cert(sa),
+      projectId: (process.env.FIREBASE_PROJECT_ID || sa.project_id || fileConfig.projectId || '').toString(),
+    },
+    'tenant-admin'
+  );
+  return appInstance;
+}
+
+export function adminAuth(): Auth {
+  return getAuth(adminApp());
+}
+
+export function adminDb(): Firestore {
+  const databaseId = (process.env.FIREBASE_DATABASE_ID || fileConfig.firestoreDatabaseId || '').toString().trim();
+  return databaseId && databaseId !== '(default)' ? getFirestore(adminApp(), databaseId) : getFirestore(adminApp());
+}
+
+export { applicationDefault };
diff --git a/api/_lib/guard.ts b/api/_lib/guard.ts
new file mode 100644
index 0000000..5572375
--- /dev/null
+++ b/api/_lib/guard.ts
@@ -0,0 +1,23 @@
+import { authErrorResponse, requireActiveTenant, requireHomeTenantPermission, requirePermission } from './authContext.js';
+
+type Handler = (req: any, res: any) => any;
+
+/** Wraps a Vercel handler so the verified-identity check runs first (CORS preflights pass straight through). */
+export function guarded(check: (headers: Record<string, any>) => Promise<unknown>, handler: Handler): Handler {
+  return async (req, res) => {
+    if (req.method === 'OPTIONS') return handler(req, res);
+    try {
+      await check(req.headers || {});
+    } catch (err) {
+      const known = authErrorResponse(err);
+      if (known) return res.status(known.status).json(known.json);
+      console.error('[guard] auth check failed:', err);
+      return res.status(500).json({ success: false, error: 'Could not verify your session.' });
+    }
+    return handler(req, res);
+  };
+}
+
+export const anyActiveUser = (h: Record<string, any>) => requireActiveTenant(h);
+export const withPermission = (...perms: string[]) => (h: Record<string, any>) => requirePermission(h, ...perms);
+export const withHomePermission = (...perms: string[]) => (h: Record<string, any>) => requireHomeTenantPermission(h, ...perms);
