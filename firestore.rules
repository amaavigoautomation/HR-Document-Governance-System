rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny for any undeclared path
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------------------------------
    // Multi-tenant access control.
    // Every record carries a companyId. A signed-in user's company, status and permissions are custom
    // claims on their ID token, written only by the server (api/_lib/tenantAdmin.ts). Users cannot edit
    // their own claims, so these checks cannot be bypassed from the browser.
    //   cid = company id, cs = company status, perms = permission keys, pa = platform admin
    // A company that is still PENDING (or suspended) has cs != 'ACTIVE', so it can read nothing.
    // ---------------------------------------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function claim(name) { return request.auth.token[name]; }
    function myCompany() { return request.auth.token.get('cid', ''); }
    function isActive() {
      return signedIn() && myCompany() != '' && request.auth.token.get('cs', '') == 'ACTIVE';
    }
    function has(p) { return isActive() && (p in request.auth.token.get('perms', [])); }
    function hasAny(list) { return isActive() && request.auth.token.get('perms', []).hasAny(list); }
    function isPlatformAdmin() { return signedIn() && request.auth.token.get('pa', false) == true; }

    function inMyCompany() { return isActive() && resource.data.companyId == myCompany(); }
    function createsInMyCompany() { return isActive() && request.resource.data.companyId == myCompany(); }
    function keepsCompany() { return request.resource.data.companyId == resource.data.companyId; }

    // Helper functions for validation
    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidEmployee(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 128
        && data.email is string
        && data.email.size() <= 128
        && data.role is string
        && (
          data.role == 'EMPLOYEE'
          || data.role == 'CREATOR'
          || data.role == 'REVIEWER'
          || data.role == 'HR'
          || data.role == 'APPROVER'
        )
        && (
          !('empId' in data)
          || (data.empId is string && data.empId.size() <= 64)
        )
        && (
          !('title' in data)
          || (data.title is string && data.title.size() <= 128)
        )
        && (
          !('departmentName' in data)
          || (
            data.departmentName is string
            && data.departmentName.size() <= 128
          )
        )
        && (
          !('companyName' in data)
          || (
            data.companyName is string
            && data.companyName.size() <= 128
          )
        )
        && (
          !('authorizedModules' in data)
          || (
            data.authorizedModules is string
            && data.authorizedModules.size() <= 128
          )
          || data.authorizedModules is list
        );
    }

    function isValidDocument(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 500
        && data.category is string
        && data.category.size() <= 64
        && (
          !('department' in data)
          || (
            data.department is string
            && data.department.size() <= 128
          )
        )
        && (
          !('confidentiality' in data)
          || (
            data.confidentiality is string
            && data.confidentiality.size() <= 64
          )
        )
        && (
          !('status' in data)
          || (
            data.status is string
            && data.status.size() <= 64
          )
        );
    }

    function isValidVersion(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.versionNumber is string
        && data.versionNumber.size() <= 32
        && (
          !('documentMasterId' in data)
          || (
            data.documentMasterId is string
            && data.documentMasterId.size() <= 128
          )
        )
        && (
          !('approvalStatus' in data)
          || (
            data.approvalStatus is string
            && (
              data.approvalStatus == 'DRAFT'
              || data.approvalStatus == 'IN_REVIEW'
              || data.approvalStatus == 'APPROVED'
              || data.approvalStatus == 'REJECTED'
              || data.approvalStatus == 'PUBLISHED'
              || data.approvalStatus == 'ARCHIVED'
            )
          )
        )
        && (
          !('changeSummary' in data)
          || (
            data.changeSummary is string
            && data.changeSummary.size() <= 4000
          )
        )
        && (
          !('authorName' in data)
          || (
            data.authorName is string
            && data.authorName.size() <= 128
          )
        )
        && (
          !('effectiveFrom' in data)
          || (
            data.effectiveFrom is string
            && data.effectiveFrom.size() <= 64
          )
        )
        && (
          !('reviewDueDate' in data)
          || (
            data.reviewDueDate is string
            && data.reviewDueDate.size() <= 64
          )
        );
    }

    function isValidAuditLog(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.action is string
        && data.action.size() <= 64
        && (
          !('documentId' in data)
          || (
            data.documentId is string
            && data.documentId.size() <= 128
          )
        )
        && (
          !('performedAt' in data)
          || (
            data.performedAt is string
            && data.performedAt.size() <= 64
          )
        )
        && (
          !('timestamp' in data)
          || (
            data.timestamp is string
            && data.timestamp.size() <= 64
          )
        )
        && (
          !('details' in data)
          || (
            data.details is string
            && data.details.size() <= 4000
          )
        );
    }

    function isValidAcknowledgment(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.documentId is string
        && data.documentId.size() > 0
        && data.documentId.size() <= 128
        && data.versionNumber is string
        && data.versionNumber.size() <= 32
        && data.status is string
        && (
          data.status == 'PENDING'
          || data.status == 'ACKNOWLEDGED'
        )
        && (
          !('employeeId' in data)
          || (
            data.employeeId is string
            && data.employeeId.size() <= 128
          )
        )
        && (
          !('employeeEmail' in data)
          || (
            data.employeeEmail is string
            && data.employeeEmail.size() <= 128
          )
        );
    }

    function isValidNotification(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.title is string
        && data.title.size() <= 256
        && data.message is string
        && data.message.size() <= 5000;
    }

    function isValidDocumentSuggestion(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.documentId is string
        && data.documentId.size() <= 128
        && data.subject is string
        && data.subject.size() <= 256
        && data.content is string
        && data.content.size() <= 5000
        && (
          !('employeeName' in data)
          || (
            data.employeeName is string
            && data.employeeName.size() <= 128
          )
        )
        && (
          !('status' in data)
          || (
            data.status is string
            && data.status.size() <= 64
          )
        );
    }

    function isValidRequisition(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.reqNo is string
        && data.reqNo.size() <= 32
        && data.positionTitle is string
        && data.positionTitle.size() > 0
        && data.positionTitle.size() <= 200
        && data.departmentName is string
        && data.departmentName.size() <= 200
        && data.status is string
        && data.status in [
          'PENDING_ASSIGNMENT',
          'PENDING_HR',
          'PENDING_FOUNDER',
          'JD_DRAFT',
          'JOB_OPEN',
          'REJECTED',
          'CLOSED'
        ]
        && data.justification is string
        && data.justification.size() <= 4000
        && data.events is list
        && data.events.size() <= 200
        && (
          !('jd' in data)
          || data.jd == null
          || (
            data.jd.text is string
            && data.jd.text.size() <= 20000
          )
        );
    }

    // 0. Companies: a member can read their own company (this is how the app learns it is still pending).
    // All writes (sign-up, approval, suspension, modules) go through the server.
    match /companies/{companyId} {
      allow read: if signedIn() && (myCompany() == companyId || isPlatformAdmin());
      allow write: if false;
    }

    // 1. Employee directory & profiles. Written only by the server (user creation sets Auth + claims too).
    match /employees/{employeeId} {
      allow get: if signedIn() && (request.auth.uid == employeeId || inMyCompany());
      allow list: if isActive() && resource.data.companyId == myCompany();
      allow write: if false;
    }

    // 1b. Departments and roles: everyone in the company can read; only the server writes.
    match /departments/{id} {
      allow read: if inMyCompany();
      allow write: if false;
    }

    match /roles/{id} {
      allow read: if inMyCompany();
      allow write: if false;
    }

    // 2. Document master records
    match /documents/{docId} {
      allow read: if inMyCompany();

      allow create: if isValidId(docId)
        && has('doc.create')
        && createsInMyCompany()
        && isValidDocument(request.resource.data);

      allow update: if isValidId(docId)
        && inMyCompany()
        && hasAny(['doc.create', 'doc.review', 'doc.publish'])
        && keepsCompany()
        && isValidDocument(request.resource.data)
        && request.resource.data.id == resource.data.id;

      allow delete: if inMyCompany() && has('doc.delete');
    }

    // 3. Document versions
    match /versions/{versionId} {
      allow read: if inMyCompany();

      allow create: if isValidId(versionId)
        && has('doc.create')
        && createsInMyCompany()
        && isValidVersion(request.resource.data);

      allow update: if isValidId(versionId)
        && inMyCompany()
        && hasAny(['doc.create', 'doc.review', 'doc.publish'])
        && keepsCompany()
        && isValidVersion(request.resource.data)
        && request.resource.data.id == resource.data.id;

      allow delete: if inMyCompany() && hasAny(['doc.delete', 'doc.create']);
    }

    // 4. Immutable audit logs: write-once, readable inside the company.
    match /auditLogs/{logId} {
      allow read: if inMyCompany();

      allow create: if isValidId(logId)
        && createsInMyCompany()
        && isValidAuditLog(request.resource.data);

      allow update: if false;
      allow delete: if false;
    }

    // 5. Policy acknowledgments. Cannot be moved from ACKNOWLEDGED back to PENDING.
    match /acknowledgments/{ackId} {
      allow read: if inMyCompany();

      allow create: if isValidId(ackId)
        && hasAny(['doc.acknowledge', 'doc.create', 'doc.publish', 'doc.review'])
        && createsInMyCompany()
        && isValidAcknowledgment(request.resource.data);

      allow update: if isValidId(ackId)
        && inMyCompany()
        && hasAny(['doc.acknowledge', 'doc.create', 'doc.publish', 'doc.review'])
        && keepsCompany()
        && isValidAcknowledgment(request.resource.data)
        && !(
          resource.data.status == 'ACKNOWLEDGED'
          && request.resource.data.status == 'PENDING'
        );

      allow delete: if inMyCompany() && hasAny(['doc.delete', 'doc.create']);
    }

    // 6. In-app notifications (created on behalf of other people, so any active member may write them).
    match /notifications/{notifId} {
      allow read: if inMyCompany();

      allow create: if isValidId(notifId)
        && createsInMyCompany()
        && isValidNotification(request.resource.data);

      allow update: if isValidId(notifId)
        && inMyCompany()
        && keepsCompany()
        && isValidNotification(request.resource.data);

      allow delete: if inMyCompany();
    }

    // 7. Employee document suggestions
    match /documentSuggestions/{suggestionId} {
      allow read: if inMyCompany();

      allow create: if isValidId(suggestionId)
        && has('doc.suggest')
        && createsInMyCompany()
        && isValidDocumentSuggestion(request.resource.data);

      allow update: if isValidId(suggestionId)
        && inMyCompany()
        && hasAny(['doc.review', 'doc.create', 'doc.publish'])
        && keepsCompany()
        && isValidDocumentSuggestion(request.resource.data);

      allow delete: if inMyCompany() && hasAny(['doc.review', 'doc.create', 'doc.delete']);
    }

    // 8. Hiring requisitions: Request -> HR -> Founder -> JD -> Job.
    // Rules check tenant + that the person holds some hiring permission; the step-by-step workflow rules
    // (who may approve at which status) are enforced in the app layer (src/utils/requisitionPermissions.ts).
    match /requisitions/{requisitionId} {
      allow read: if inMyCompany()
        && hasAny(['req.create', 'req.view_all', 'req.assign', 'req.hr_decide', 'req.founder_decide', 'req.manage_jd']);

      allow create: if isValidId(requisitionId)
        && has('req.create')
        && createsInMyCompany()
        && isValidRequisition(request.resource.data);

      allow update: if isValidId(requisitionId)
        && inMyCompany()
        && hasAny(['req.create', 'req.assign', 'req.hr_decide', 'req.founder_decide', 'req.manage_jd'])
        && keepsCompany()
        && isValidRequisition(request.resource.data)
        && request.resource.data.id == resource.data.id;

      allow delete: if false;
    }

    // 9. Server-only collections. The backend uses the Admin SDK (which bypasses these rules), and
    //    browsers must never read or write them directly: they hold candidate data, documents, the
    //    webhook key hashes and cached AI scoring. Every record carries a companyId.
    match /onboardings/{id} { allow read, write: if false; }
    match /onboardingFiles/{id} { allow read, write: if false; }
    match /candidateStatuses/{id} { allow read, write: if false; }
    match /counters/{id} { allow read, write: if false; }
    match /candidateEvaluations/{id} { allow read, write: if false; }
    match /jobDescriptions/{id} { allow read, write: if false; }
    match /applications/{id} { allow read, write: if false; }
    match /recruitmentSettings/{id} { allow read, write: if false; }
    match /leaveSettings/{id} { allow read, write: if false; }
    match /leaveProfiles/{id} { allow read, write: if false; }
    match /leaveLedger/{id} { allow read, write: if false; }
    match /leaveRequests/{id} { allow read, write: if false; }
    match /leaveAttendance/{id} { allow read, write: if false; }
    match /leaveRegularizations/{id} { allow read, write: if false; }
    // Payroll: salary data is server-only. Browsers never read or write these directly.
    match /payrollSettings/{id} { allow read, write: if false; }
    match /payrollStructures/{id} { allow read, write: if false; }
    match /payrollAdjustments/{id} { allow read, write: if false; }
    match /payrollLoans/{id} { allow read, write: if false; }
    match /payrollRuns/{id} { allow read, write: if false; }
    match /payrollRunLines/{id} { allow read, write: if false; }
    match /payrollRevisions/{id} { allow read, write: if false; }
    match /payrollClaims/{id} { allow read, write: if false; }
    match /payrollClaimFiles/{id} { allow read, write: if false; }
    match /payrollSettlements/{id} { allow read, write: if false; }
    match /payrollDeclarations/{id} { allow read, write: if false; }
    // People lifecycle: server-only.
    match /lifecycleSettings/{id} { allow read, write: if false; }
    match /lifecycleTasks/{id} { allow read, write: if false; }
    match /lifecycleBank/{id} { allow read, write: if false; }
    match /lifecycleExits/{id} { allow read, write: if false; }
    match /lifecycleLetters/{id} { allow read, write: if false; }
    // Home page: server-only. personalDates holds birth and marriage dates, which colleagues must not be able to read.
    match /homeSettings/{id} { allow read, write: if false; }
    match /announcements/{id} { allow read, write: if false; }
    match /moodCheckins/{id} { allow read, write: if false; }
    match /loginDaily/{id} { allow read, write: if false; }
    match /personalDates/{id} { allow read, write: if false; }
    match /employeeProfiles/{id} { allow read, write: if false; }
  }
}
