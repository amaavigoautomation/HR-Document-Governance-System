+  return h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
+};
+
+/** Balance tiles: big number left, small bar showing used vs total. */
+export const BalanceStrip: React.FC<{ me: any; onApply?: (typeId: string) => void }> = ({ me, onApply }) => {
