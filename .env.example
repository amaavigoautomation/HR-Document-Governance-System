# ---- AI ----
GEMINI_API_KEY=

# ---- App ----
APP_URL=

# ---- Firebase Admin (REQUIRED for sign-up, user management, approvals and verified API calls) ----
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON, or its base64, as one value. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Database (MongoDB) ----
# All app data lives in MongoDB. Atlas gives you a connection string; use a paid tier (Flex or higher) once real
# data goes in, so you get backups. Browsers never talk to the database: everything goes through the server.
MONGODB_URI=
# Optional: database name. Defaults to the name in the connection string, otherwise "hr_governance".
MONGODB_DB=

# ---- Tenancy ----
# The company that owns the single-tenant features (Google Sheet, careers API, onboarding, AI candidate
# evaluation). Set it to that company's id (see scripts/migrate-to-multitenant.ts output).
HOME_COMPANY_ID=

# ---- Uploaded-file links ----
# Secret used to sign file links. If empty it is derived from the service account.
STORAGE_URL_SECRET=
# true = also accept old links that have no signature (use only while migrating old documents).
LEGACY_OPEN_STORAGE=false

# ---- Email (shared by all companies for now) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# ---- Talent acquisition (home company only) ----
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=

# ---- Onboarding server ----
ONBOARDING_SERVER_PASSWORD=
CRON_SECRET=


# Google Calendar / Meet for interviews (one connection per company; each Company Admin connects their own Google account)
# Create an OAuth client (Web application) in Google Cloud with the Calendar API enabled. Authorised redirect URI:
#   <APP_BASE_URL>/api/recruitment/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random text (32+ characters). Encrypts the stored Google tokens and signs the sign-in link. Do not change it later or companies must reconnect.
GOOGLE_TOKEN_KEY=
