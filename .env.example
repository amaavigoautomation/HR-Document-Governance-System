# ---- AI ----
GEMINI_API_KEY=

# ---- App ----
APP_URL=

# ---- Firebase Admin (REQUIRED for sign-up, user management, approvals and verified API calls) ----
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON, or its base64, as one value. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Use a different Firebase project for one deployment (e.g. the sahil-3 branch) ----
# Leave all of these unset to keep using firebase-applet-config.json (the original project).
# Server (runtime):
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=
# Browser (build time, same values, VITE_ prefix):
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=

# ---- Tenancy ----
# The company that owns the single-tenant features (Google Sheet, careers API, onboarding, AI candidate
# evaluation). Set it to that company's id (see scripts/migrate-to-multitenant.ts output).
HOME_COMPANY_ID=

# ---- Uploaded-file links ----
# Secret used to sign file links. If empty it is derived from the service account.
STORAGE_URL_SECRET=
# true = also accept old links that have no signature (use only while migrating old documents).
LEGACY_OPEN_STORAGE=false

# ---- Email (shared by all companies for now) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# ---- Talent acquisition (home company only) ----
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=

# ---- Onboarding server ----
ONBOARDING_SERVER_PASSWORD=
CRON_SECRET=
